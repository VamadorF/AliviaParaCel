{
  "expo": {
    "name": "AlivIA",
    "slug": "alivia-para-cel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "scheme": "alivia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.alivia.paciente"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/adaptive-icon.png",
        "backgroundColor": "#eef1ec"
      },
      "package": "cl.alivia.paciente",
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./public/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "REEMPLAZA_CON_TU_PROJECT_ID",
        "_comment": "projectId pendiente: crear cuenta EAS y reemplazar antes de builds production"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./public/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#eef1ec"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "AlivIA usa tu foto solo en este teléfono, para tu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#256e4d",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ]
  }
}
